{
  "expo": {
    "name": "Leave system",
    "slug": "leave-system",
    "scheme": "leavesystem",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.leavesystem"
    },
    "android": {
      "package": "com.example.leavesystem"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Leave system",
      "shortName": "Leave"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
