# Server configuration (names only - never commit real values).
# Copy this file to server/.env and fill it in. server/.env is git-ignored.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- MySQL -------------------------------------------------------------------
# The API connects with the least-privilege application account only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leave_system
DB_APP_USER=leave_app
DB_APP_PASSWORD=

# Used only by db/apply.mjs and db/seed.mjs. Leave empty for the API runtime.
DB_MIGRATOR_USER=leave_migrator
DB_MIGRATOR_PASSWORD=
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_REPORT_USER=leave_report
DB_REPORT_PASSWORD=

# Host part of the MySQL account names ('localhost' by default; widen only when
# the API runs on a different machine, and restrict it as tightly as possible).
DB_USER_HOST=localhost

# --- tokens (step 2) ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 random bytes. Separate values for access and refresh signing.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=leave-system-api
JWT_AUDIENCE=leave-system-client

# --- web client --------------------------------------------------------------
# Comma-separated exact origins. No wildcards.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- uploads (step 3) --------------------------------------------------------
# Absolute path outside the server's web root. The directory must exist.
UPLOAD_DIR=

# --- seed (development only) -------------------------------------------------
# Optional. If unset, the admin password is generated and printed once.
SEED_ADMIN_PASSWORD=
