# Server configuration (names only - never commit real values).
# Copy this file to server/.env and fill it in. server/.env is git-ignored.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- MySQL -------------------------------------------------------------------
# The API connects with the least-privilege application account only.
# DB_APP_USER must not be root, leave_migrator or leave_report.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leave_system
DB_APP_USER=leave_app
DB_APP_PASSWORD=

# Used only by db/apply.mjs and db/seed.mjs. Leave empty for the API runtime.
DB_MIGRATOR_USER=leave_migrator
DB_MIGRATOR_PASSWORD=
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_REPORT_USER=leave_report
DB_REPORT_PASSWORD=

# Host part of the MySQL account names ('localhost' by default; widen only when
# the API runs on a different machine, and restrict it as tightly as possible).
DB_USER_HOST=localhost

# --- tokens ------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 random bytes, and the two values must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=leave-system-api
JWT_AUDIENCE=leave-system-client

# --- web client --------------------------------------------------------------
# Comma-separated exact origins. No wildcards. HTTPS is required in production
# (localhost/127.0.0.1 excepted for local development).
CORS_ORIGINS=http://localhost:8081

# --- transport ---------------------------------------------------------------
# Cookies are always Secure in production; keep true in development too if you
# test over https. Set false only for localhost development over http.
COOKIE_SECURE=true
# Optional. Leave empty to host the cookie on the API host only.
COOKIE_DOMAIN=
# Number of reverse-proxy hops in front of Express. 0 = direct, 1 = one proxy.
# Production behind nginx/Cloudflare-style proxies usually needs 1; never use
# "true" (trust every hop).
TRUST_PROXY=0
# Refuse plain HTTP. Defaults to true in production and false otherwise.
FORCE_HTTPS=false

# --- rate limits (per 15 minutes, per IP) ------------------------------------
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60

# --- uploads (step 3) --------------------------------------------------------
# Absolute path outside the server's web root. The directory must exist.
UPLOAD_DIR=

# --- seed (development only) -------------------------------------------------
# Optional. If unset, the admin password is generated and printed once.
SEED_ADMIN_PASSWORD=
