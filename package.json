{
  "name": "employee-leave-system",
  "version": "0.1.0",
  "private": true,
  "description": "Employee Leave Application System - Expo client, Express API, MySQL",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "shared",
    "server",
    "app"
  ],
  "scripts": {
    "db:apply": "node db/apply.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "build:shared": "npm run build -w @leave/shared",
    "dev:server": "npm run dev -w @leave/server",
    "test:server": "npm run test -w @leave/server",
    "check:sql": "npm run check:sql -w @leave/server",
    "dev:app": "npm run start -w @leave/app",
    "dev:web": "npm run web -w @leave/app",
    "typecheck:app": "npm run typecheck -w @leave/app"
  },
  "devDependencies": {
    "argon2": "0.45.2",
    "mysql2": "3.24.6"
  },
  "overrides": {
    "jest": "29.7.0",
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
